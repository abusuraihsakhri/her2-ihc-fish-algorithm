{
  "openapi": "3.1.0",
  "info": {
    "title": "Her2 Ihc Fish Algorithm API",
    "description": "HER2 IHC and dual-probe ISH educational interpretation API; includes optional, nonclinical audit demonstration endpoints.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counters for the nonclinical audit demonstration",
        "responses": {
          "200": {
            "description": "JSON audit counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic demonstration chat (not a clinical language-model service)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/her2": {
      "post": {
        "summary": "Interpret HER2 IHC and dual-probe ISH (ASCO/CAP 2018 reaffirmed 2023)",
        "description": "Groups 2-4 may require IHC/recount; no clinical treatment recommendation is supplied.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ihc_score": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "percent_staining": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "her2_copy_number": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cep17_copy_number": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "her2_ceph_ratio": {
                    "type": "number",
                    "minimum": 0
                  },
                  "guideline_year": {
                    "type": "integer",
                    "enum": [
                      2018,
                      2023
                    ]
                  },
                  "recount_her2_copy_number": {
                    "type": "number",
                    "minimum": 0
                  },
                  "recount_cep17_copy_number": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "ihc_score"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "IHC/ISH assessment with pending-state safety checks"
          },
          "422": {
            "description": "Input validation error"
          }
        }
      }
    }
  }
}
